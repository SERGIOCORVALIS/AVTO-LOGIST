###############################################################################
# AutoLogistics OS — TRANSINVEST AI-логист
# Premium environment template
#
#   copy .env.example .env
#
# Полная инструкция по переменным: docs/ENV_SETUP.md
# Бизнес-логика ТЗ:          docs/BUSINESS_LOGIC_TZ.md
#
# Приоритет коммерции: policy_config (кабинет / Management Bot) > .env > дефолты кода
# dotenv / docker compose --env-file .env читают ВСЕ ключи ниже.
# НИКОГДА не коммитьте .env с секретами.
###############################################################################

# =============================================================================
# 1. Core runtime
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info
LOG_DIR=./logs
ALO_ENV=development
LICENSE_KEY=

# =============================================================================
# 2. API / Orchestrator / Web cabinet
# =============================================================================
API_PORT=3000
API_HOST=0.0.0.0
API_URL=http://localhost:3000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
ORCHESTRATOR_URL=http://localhost:8000
JWT_SECRET=
CABINET_CORS_ORIGIN=http://localhost:5173
CABINET_DIRECTOR_EMAIL=director@transinvest.local
CABINET_DIRECTOR_PASSWORD=TransinvestDir!2026
CABINET_DIRECTOR_NAME=Директор
CABINET_MANAGER_EMAIL=manager@transinvest.local
CABINET_MANAGER_PASSWORD=TransinvestMgr!2026
CABINET_MANAGER_NAME=Менеджер
WEB_PORT=8080
CABINET_AUTH_REQUIRED=false
ALLOW_INSECURE_CABINET=false
REQUIRE_HUMAN_KP_APPROVE=true
SEED_SUPPLIERS_ON_BOOT=true
SUPPLIER_SILENT_AFTER_STREAK=3
SUPPLIER_SILENT_AFTER_HOURS=72
INTERNAL_API_TOKEN=

# =============================================================================
# 3. Data plane — Redis / Postgres / S3
# =============================================================================
REDIS_URL=redis://127.0.0.1:6379
POSTGRES_PORT=5432
POSTGRES_USER=alo
POSTGRES_PASSWORD=alo
DATABASE_URL=postgresql://alo:alo@127.0.0.1:5434/autologistics
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=alo-files
S3_REGION=us-east-1

# =============================================================================
# 4. Rates / RFQ channels (SUPPLIER_* == PARTNER_* aliases)
# СДЭК — не auto-RFQ. ПЭК / ДЛ / Байкал — могут быть поставщиками сборки.
# =============================================================================
ALLOW_MOCK_RATES=false
ALLOW_FILE_TARIFFS=false
PARTNER_QUOTE_EMAILS=
SUPPLIER_QUOTE_EMAILS=
SUPPLIER_EMAIL_PEK=
PARTNER_CDEK_ACCOUNT=
PARTNER_CDEK_SECURE=
PARTNER_NEGOTIATE_EMAIL=
SOURCING_QUOTE_EMAILS=
SOURCING_EMAIL_CN=
HS_FEED_URL=
OPS_LOCAL_RUB=8000
OPS_FEE_RUB=5000
OPS_INSURANCE_PCT=0.02

# =============================================================================
# 5. Company / legal entity (customer-facing)
# =============================================================================
COMPANY_LEGAL_NAME=
COMPANY_SHORT_NAME=
COMPANY_OGRN=
COMPANY_OGRN_DATE=
COMPANY_REGISTRATION_DATE=
COMPANY_INN=
COMPANY_KPP=
COMPANY_LEGAL_ADDRESS=
COMPANY_DIRECTOR_TITLE=
COMPANY_DIRECTOR_NAME=
COMPANY_DIRECTOR_SINCE=
COMPANY_STATUS=
COMPANY_STATUS_ASSIGNED=
