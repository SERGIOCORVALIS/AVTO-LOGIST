# =============================================================================
# 6. Commercial policy — ТЗ TRANSINVEST AI-логист v1
# Читает: services/agents/tz_policy.py → policy_from_env() / merge_tz_policy()
# =============================================================================
TARGET_MARGIN_PCT=18
FLOOR_MARGIN_PCT=10
MAX_DISCOUNT_PCT=8
MIN_GROSS_PROFIT_RUB=3000
ESCALATE_AMOUNT_RUB=500000
FIRST_REPLY_SLA_SEC=120
QUOTE_SLA_HOURS=2
LEARNING_ENABLED=true
CANARY_PCT=10
RU_VAT_PCT=22
DEFAULT_VAT_PCT=22
INTL_FREIGHT_VAT_PCT=0
CLIENT_RU_SELLS_WITH_VAT=true
BROKER_COST_RUB=15000
BROKER_CLIENT_PRICE_RUB=20000
BROKER_DT_ITEM_LIMIT=4
CERTIFICATION_MARKUP_PCT=5
BUYOUT_COMMISSION_PCT=5
BUYOUT_FX_MARKUP_RUB=0.45
PREPAY_PREFERRED_PCT=100
PREPAY_MIN_PCT_UNDER_1M=50
STAGED_PAYMENT_THRESHOLD_RUB=1000000
RFQ_TARGET_MIN=10
RFQ_TARGET_MAX=20
RFQ_TARGET_COUNT=15
IMPORTER_SCHEME=manual
CUSTOMS_CONFIRMED_AUTONOMY_THRESHOLD=500
HS_ALWAYS_PRELIMINARY_FOR_CLIENT=true
FOLLOWUP_DEFAULT_HOURS=24,72,168
FOLLOWUP_URGENT_HOURS=2
FOLLOWUP_OPERATIONAL_SILENCE_HOURS=2.5
SHIPMENT_URGENT_DAYS=14
VIP_VOLUME_MIN=5
VIP_VOLUME_MAX=50
LONG_ROUTE_COMPARE_KM=2100
NIGHT_EXPRESS_ENABLED=true
CARRIER_PENALTY_CLIENT_RUB=
CARRIER_PENALTY_SUPPLIER_RUB=
ACADEMY_ENABLED=true
ACADEMY_IN_KP=true
ACADEMY_IN_RFQ=true
ACADEMY_IN_PROMPTS=true
ACADEMY_IN_VOICE=true

# =============================================================================
# 7. OpenAI (GPT + Realtime + embeddings)
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol,gpt-5.5,gpt-4o
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_CODING_MODEL=gpt-5.6-sol
OPENAI_DOCUMENT_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SEC=60
OPENAI_MAX_COMPLETION_TOKENS=8192
GPT_DAILY_BUDGET_USD=0
GPT_MONTHLY_BUDGET_USD=0
GPT_INPUT_USD_PER_1M=3
GPT_OUTPUT_USD_PER_1M=12
GPT_BUDGET_REDIS=true

