###############################################################################
# AutoLogistics OS — environment template
# Copy to .env and fill values. NEVER commit .env with real secrets.
#
#   copy .env.example .env
#
# Premium English guide (every key, where to register, links):
#   docs/ENV_SETUP.md
# Docs hub:
#   docs/INDEX.md
#
# Minimum for local Docker start:
#   DATABASE_URL, REDIS_URL (defaults below already work)
# Add Telegram / LLM / mail / voice as you leave heuristic mode.
###############################################################################

# =============================================================================
# Core runtime
# =============================================================================
# development | production | test
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# Root for structured logs (api/gateway/workers/orchestrator/audit/bootstrap)
LOG_DIR=./logs

# -----------------------------------------------------------------------------
# Proprietary license gate (API + tg-gateway + voice-gateway)
# -----------------------------------------------------------------------------
# First start records data/license.state.json. For 180 days after install, services
# may start without a key. After that window they REFUSE without LICENSE_KEY.
# Issue a signed key (author):  node scripts/issue-license.mjs --days 180
# LICENSE_KEY=
# Require key immediately (skip 180-day grace):     
# LICENSE_ENFORCE=true
# Skip check in non-production only (CI/dev):
# LICENSE_SKIP=true
# Optional custom HMAC secret when issuing customer keys:
# LICENSE_ISSUER_SECRET=
# LICENSE_STATE_PATH=./data/license.state.json

# HTTP API (apps/api)
API_PORT=3000
API_HOST=0.0.0.0
# Base URL for gateway/workers (no trailing slash)
API_URL=http://localhost:3000
# Python orchestrator
ORCHESTRATOR_URL=http://localhost:8000

# Redis (BullMQ: inbound/outbound/email/ocr/sla/digest/dlq)
REDIS_URL=redis://localhost:6379

# Postgres + pgvector (schema: infra/init.sql)
DATABASE_URL=postgresql://alo:alo@localhost:5432/autologistics

# Object storage (invoices, contracts, mail attachments)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=alo-files
# S3_REGION=us-east-1

# Shared secret for /internal/* (required in production)
# INTERNAL_API_TOKEN=

# =============================================================================
# Company / legal entity (ООО «ЖД Трансинвест»)
# Customer-facing: voice greeting, email From/signature, contract drafts.
# Product name AutoLogistics OS stays internal (API, digests, management bot).
# =============================================================================
COMPANY_LEGAL_NAME=
COMPANY_SHORT_NAME=
COMPANY_OGRN=
COMPANY_OGRN_DATE=
COMPANY_REGISTRATION_DATE=
COMPANY_INN=
COMPANY_KPP=
COMPANY_LEGAL_ADDRESS=
COMPANY_DIRECTOR_TITLE=Director
COMPANY_DIRECTOR_NAME=
COMPANY_DIRECTOR_SINCE=
COMPANY_STATUS=microenterprise
COMPANY_STATUS_ASSIGNED=
COMPANY_OKVED_CODE=52.29
COMPANY_OKVED_NAME=Other supporting transport activities
COMPANY_TAX_AUTHORITY=
COMPANY_TAX_AUTHORITY_SINCE=
COMPANY_OKPO=
COMPANY_OKATO=
COMPANY_OKTMO=
COMPANY_OKFS=16
COMPANY_OKFS_NAME=Private ownership
COMPANY_OKOGU=
COMPANY_OKOGU_NAME=
COMPANY_OKOPF=
COMPANY_OKOPF_NAME=Limited liability company
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=

# =============================================================================
# Commercial policy (also editable via Management Bot: /margin /floor /policy)
# =============================================================================
TARGET_MARGIN_PCT=18
FLOOR_MARGIN_PCT=10
MAX_DISCOUNT_PCT=8
ESCALATE_AMOUNT_RUB=500000
FIRST_REPLY_SLA_SEC=120
QUOTE_SLA_HOURS=2
LEARNING_ENABLED=true
CANARY_PCT=10

# =============================================================================
# OpenAI — GPT (dialogue, negotiation, orchestration, OCR, embeddings)
# Without key: heuristic concierge / negotiator (dev mode)
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# DeepSeek — legal / customs / contracts
# Without key: heuristic legal + contract draft
# =============================================================================
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# =============================================================================
# Telegram — client user account (GramJS)
# API: https://my.telegram.org
# Session: pnpm --filter @alo/tg-gateway login
# =============================================================================
TG_API_ID=
TG_API_HASH=
# Long string session after login (store as a secret!)
TG_STRING_SESSION=
TG_WORK_HOURS_START=9
TG_WORK_HOURS_END=21
TG_TZ=Europe/Moscow
# true = do not auto-reply outside work hours
TG_STRICT_HOURS=false
TG_MIN_REPLY_DELAY_MS=800
TG_MAX_REPLY_DELAY_MS=2500
TG_MAX_MSGS_PER_MINUTE=20

# =============================================================================
# Telegram — Management Bot + Executive Channel + Escalation chat
# BotFather → token; bot must be admin of report channel / escalation chat
# =============================================================================
TG_BOT_TOKEN=
# Comma-separated numeric Telegram user ids (empty = anyone)
TG_MANAGER_IDS=
# Channel id, e.g. -1001234567890
TG_EXEC_CHANNEL_ID=
# Separate managers chat for disputed deals (empty → exec channel)
TG_ESCALATION_CHAT_ID=
# Default import VAT % (RF)
DEFAULT_VAT_PCT=20

# Multi manager accounts (JSON). If set, overrides single TG_STRING_SESSION.
# TG_ACCOUNTS_JSON=[{"id":"mgr1","api_id":123456,"api_hash":"...","session":"...","manager_user_id":111,"label":"Anna"}]
# TG_DEFAULT_ACCOUNT_ID=default

# Doppler (optional): DOPPLER_TOKEN + doppler.yaml from doppler.yaml.example
# DOPPLER_TOKEN=

# =============================================================================
# Mail — provider switch
# gmail | yandex | custom
# Presets below fill host/port when MAIL_PROVIDER is set.
# =============================================================================
MAIL_PROVIDER=gmail
# app_password | oauth2
MAIL_AUTH_MODE=app_password
MAIL_SYNC_ENABLED=true
MAIL_SYNC_INTERVAL_MS=60000
MAIL_LLM_PARSE=true
MAIL_MAX_SEND_PER_MINUTE=30
MAIL_IMAP_MAILBOX=INBOX
# leave | archive | label:ALO_Processed
MAIL_IMAP_ON_PROCESSED=leave
MAIL_SUBJECT_PREFIX=Rate request
EMAIL_WHITELIST_DOMAINS=partner1.com,partner2.com
# MAIL_REQUIRE_SMTP=false
# MAIL_SECONDARY_PROVIDER=yandex
# MAIL_SECONDARY_USER=
# MAIL_SECONDARY_APP_PASSWORD=

MAIL_USER=
# App password (NOT the main account password)
MAIL_APP_PASSWORD=
MAIL_FROM=

# OAuth2 (recommended for production Gmail Workspace)
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=
MAIL_OAUTH_REFRESH_TOKEN=
# Gmail scope example: https://mail.google.com/
MAIL_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# =============================================================================
# Gmail preset (MAIL_PROVIDER=gmail)
# 1) Enable 2FA
# 2) App Password: https://myaccount.google.com/apppasswords
# 3) MAIL_USER=you@gmail.com  MAIL_APP_PASSWORD=xxxx
# Workspace: prefer MAIL_AUTH_MODE=oauth2
# =============================================================================
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_SECURE=false
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_SECURE=true

# =============================================================================
# Yandex Mail preset (MAIL_PROVIDER=yandex)
# 1) https://id.yandex.ru/security → app passwords
# 2) Enable IMAP in mailbox settings
# 3) MAIL_USER=you@yandex.ru (or @ya.ru / Yandex 360 domain)
# SMTP 465+SSL is usually more stable than 587
# =============================================================================
YANDEX_SMTP_HOST=smtp.yandex.ru
YANDEX_SMTP_PORT=465
YANDEX_SMTP_SECURE=true
YANDEX_IMAP_HOST=imap.yandex.ru
YANDEX_IMAP_PORT=993
YANDEX_IMAP_SECURE=true

# =============================================================================
# Custom SMTP/IMAP (MAIL_PROVIDER=custom)
# If MAIL_PROVIDER=gmail|yandex, leave empty — workers apply presets.
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=

# =============================================================================
# Voice — SIP trunk + OpenAI Realtime (apps/voice-gateway)
# Providers: SIP_PROVIDER=zadarma | beeline (beeline_business)
# Transfer: VOICE_MANAGER_TRANSFER_NUMBER (E.164)
# =============================================================================
SIP_ENABLED=true
SIP_PROVIDER=zadarma
# Defaults by provider; override if portal shows another domain
SIP_DOMAIN=
SIP_USERNAME=
SIP_PASSWORD=
# SIP_AUTH_USERNAME=74951234567@sip.beeline.ru
# SIP_OUTBOUND_PROXY=
SIP_URI_MODE=0
SIP_BIND_HOST=0.0.0.0
SIP_PORT=5060
SIP_PUBLIC_HOST=
SIP_LOCAL_IP=
SIP_RTP_PORT_MIN=10000
SIP_RTP_PORT_MAX=20000
SIP_CODEC=
SIP_ALLOWED_IPS=
SIP_MAX_CONCURRENT_CALLS=20
SIP_REGISTER_EXPIRES=
SIP_KEEPALIVE_URI=
VOICE_DID_NUMBER=+7
VOICE_GATEWAY_PORT=3010
VOICE_GATEWAY_HOST=0.0.0.0
VOICE_GATEWAY_URL=http://localhost:3010
VOICE_GATEWAY_PUBLIC_URL=https://voice.example.com
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
VOICE_PERSONA=alloy
VOICE_COMPANY_NAME=
VOICE_AGENT_NAME=
VOICE_MANAGER_TRANSFER_NUMBER=+7
VOICE_RECORDING_DISCLAIMER=true
VOICE_AFTER_HOURS_MODE=message
VOICE_MAX_CALL_MINUTES=30
# VOICE_HOURS_START=9
# VOICE_HOURS_END=19
# VOICE_TZ=Europe/Moscow
# VOICE_GREETING=Hello, ...

# =============================================================================
# Observability (optional: docker compose --profile observability)
# =============================================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# =============================================================================
# Partners / rates / HS feed
# =============================================================================
# PARTNER_HTTP_<CODE>=https://partner.example.com/api
# PARTNER_KEY_<CODE>=secret
# PARTNER_CDEK_ACCOUNT=
# PARTNER_CDEK_SECURE=
# PARTNER_CDEK_FROM_CODE=44
# PARTNER_CDEK_TO_CODE=137
# PARTNER_QUOTE_EMAILS=rates@partner1.com,sales@partner2.com
# PARTNER_NEGOTIATE_EMAIL=rates@partner1.com
# ALO_ENV=development
# ALLOW_MOCK_RATES=true
# OPS_LOCAL_RUB=8000
# OPS_FEE_RUB=5000
# OPS_INSURANCE_PCT=0.02
# HS_FEED_URL=

# =============================================================================
# Google Calendar (reuse MAIL_OAUTH_* or set GOOGLE_OAUTH_*)
# OAuth refresh token must include calendar.events scope
# =============================================================================
# GOOGLE_CALENDAR_ENABLED=true
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# =============================================================================
# Python-specific (pydantic-settings / dotenv)
# =============================================================================
# PROMPTS_DIR=
